# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Demo logins for rehearsals. NEVER set DEMO_LOGIN_ENABLED=true in production.
DEMO_LOGIN_ENABLED=false
DEMO_PASSWORD=

# Pexels (free) - used only by scripts/fetch-photos.mjs to download seed photos. Get one at https://www.pexels.com/api/
PEXELS_API_KEY=
