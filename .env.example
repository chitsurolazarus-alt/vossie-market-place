# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Demo logins for rehearsals. NEVER set DEMO_LOGIN_ENABLED=true in production.
DEMO_LOGIN_ENABLED=false
DEMO_PASSWORD=

# Photo import (free): UNSPLASH_ACCESS_KEY from https://unsplash.com/developers, or PEXELS_API_KEY from https://www.pexels.com/api/. Used only by scripts/fetch-photos.mjs.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
